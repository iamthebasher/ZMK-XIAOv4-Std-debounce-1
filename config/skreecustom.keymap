#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESC             &kp N1          &kp N2              &kp N3            &kp N4          &kp N5      &kp N6     &kp N7           &kp N8             &mt LEFT_BRACKET N9  &mt RIGHT_BRACKET N0     &kp EQUAL
&kp TAB             &kp Q           &kp W               &kp E             &kp R           &kp T       &kp Y      &kp U            &kp I              &kp O                &kp P                    &kp MINUS
&mt TAB LEFT_SHIFT  &mt LEFT_ALT A  &mt LEFT_CONTROL S  &mt LEFT_SHIFT D  &mt LEFT_GUI F  &kp G       &kp H      &mt RIGHT_GUI J  &mt RIGHT_SHIFT K  &mt RIGHT_CONTROL L  &mt RIGHT_ALT SEMICOLON  &mt TAB SQT
&kp GRAVE           &kp Z           &kp X               &kp C             &kp V           &kp B       &kp N      &kp M            &kp COMMA          &kp DOT              &kp FSLH                 &kp BSLH

                                                        &kp LSHFT         &kp SPACE       &kp LGUI    &kp DEL    &kp RET          &kp BACKSPACE
                                                        &kp LCTRL         &mo 1           &to 3       &mkp LCLK  &mo 2            &mkp RCLK
            >;
        };

        layer_1 {
            bindings = <
&kp F12  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5    &kp F6      &kp F7             &kp F8           &kp F9  &kp F10  &kp F11
&trans   &trans  &trans  &trans  &trans  &trans    &trans      &trans             &trans           &trans  &trans   &trans
&trans   &trans  &trans  &trans  &trans  &trans    &kp K_MUTE  &kp K_VOLUME_DOWN  &kp K_VOLUME_UP  &trans  &trans   &trans
&trans   &trans  &trans  &trans  &trans  &trans    &trans      &trans             &trans           &trans  &trans   &trans

                         &trans  &trans  &trans    &trans      &trans             &trans
                         &trans  &trans  &trans    &trans      &trans             &trans
            >;
        };

        layer_2 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans          &trans         &trans         &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &kp HOME        &kp PAGE_DOWN  &kp PAGE_DOWN  &kp END           &kp INS            &trans
&trans  &trans  &trans  &trans  &trans  &trans    &kp LEFT_ARROW  &kp DOWN       &kp UP_ARROW   &kp RIGHT         &trans             &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans          &trans         &trans         &trans            &trans             &trans

                        &trans  &trans  &trans    &trans          &trans         &trans
                        &trans  &trans  &trans    &mkp MB4        &trans         &mkp MB5
            >;
        };

        layer_3 {
            bindings = <
&kp ESC  &kp N1            &kp N2  &kp N3     &kp N4     &kp N5      &trans      &trans             &trans           &trans  &trans  &trans
&kp T    &kp TAB           &kp Q   &kp W      &kp E      &kp R       &trans      &trans             &trans           &trans  &trans  &trans
&kp G    &kp LEFT_SHIFT    &kp A   &kp S      &kp D      &kp F       &kp K_MUTE  &kp K_VOLUME_DOWN  &kp K_VOLUME_UP  &trans  &trans  &trans
&kp B    &kp LEFT_CONTROL  &kp Z   &kp X      &kp C      &kp V       &trans      &trans             &trans           &trans  &trans  &trans

                                   &trans     &kp SPACE  &kp LGUI    &trans      &trans             &trans
                                   &kp LCTRL  &mo 4      &to 0       &mkp MB4    &trans             &mkp MB5
            >;
        };

        layer_4 {
            bindings = <
&kp ESC  &kp N6     &kp N7  &kp N8     &kp N9     &kp N0      &trans  &trans             &trans           &trans  &trans  &trans
&kp T    &kp TAB    &kp Q   &kp W      &kp E      &kp R       &trans  &trans             &trans           &trans  &trans  &trans
&kp G    &kp LSHFT  &kp A   &kp S      &kp D      &kp F       &trans  &kp K_VOLUME_DOWN  &kp K_VOLUME_UP  &trans  &trans  &trans
&kp B    &kp LCTRL  &kp Z   &kp X      &kp C      &kp V       &trans  &trans             &trans           &trans  &trans  &trans

                            &trans     &kp SPACE  &kp LGUI    &trans  &trans             &trans
                            &kp LCTRL  &trans     &trans      &trans  &trans             &trans
            >;
        };
    };
};

// //right hand trackball overrides
// &trackball_peripheral_listener {
//     input-processors =
//         <&zip_xy_transform INPUT_TRANSFORM_XY_SWAP>,//this gets it to the default installation orientation
//         <&zip_temp_layer 3 500>;//activate layer 3 within 500ms of the trackball moving
// };
// //left hand trackball overrides
// &trackball_central_listener {
//     input-processors = 
//         <&zip_xy_transform INPUT_TRANSFORM_XY_SWAP>,//this gets it to the default installation orientation
//         <&zip_xy_scaler 1 3>,//multiply sensitivity by 1, divide by 3 (make it slower for scrolling)
//         <&zip_xy_to_scroll_mapper>,//make this trackball output scrolling events by default instead of cursor movement
//         <&zip_scroll_transform INPUT_TRANSFORM_Y_INVERT>;//invert vertical scrolling so that the view moves in the same direction as the top of the trackball.
// };
